#!/bin/sh
# Refuse a branch push that leaves VERSION where the remote already has it.
#
# A guard, deliberately, and not a bump: a hook that edited VERSION here would be
# writing a commit that the push has already computed past, so every version would
# land one push late — worse than not automating it, because it would look
# automated. This just stops the push and tells you to bump.
#
# Not active in a fresh clone until:  git config core.hooksPath .githooks
set -eu

# Tag-only and delete-only pushes have no version to bump.
pushing_branch=no
while read -r _localref _localsha remoteref _remotesha; do
    case "$remoteref" in refs/heads/*) pushing_branch=yes ;; esac
done
[ "$pushing_branch" = yes ] || exit 0

local_version="$(tr -d '[:space:]' < VERSION 2>/dev/null || true)"
if [ -z "$local_version" ]; then
    echo "pre-push: no readable VERSION file at the repo root." >&2
    exit 1
fi

# Empty on the first push after VERSION is introduced, which correctly passes.
remote_version="$(git show "$1/main:VERSION" 2>/dev/null | tr -d '[:space:]' || true)"

if [ "$local_version" = "$remote_version" ]; then
    echo "pre-push: VERSION is still $local_version, same as $1." >&2
    echo "          Bump the patch in ./VERSION and amend or commit it." >&2
    echo "          Intentional exception: git push --no-verify" >&2
    exit 1
fi

# Every build is a release, so the tag exists before the push rather than after,
# and points at what is being pushed. `push.followTags` then carries it along with
# the branch, which is why it has to be annotated.
tag="v$local_version"
if ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    echo "pre-push: VERSION says $local_version but there is no $tag tag." >&2
    echo "          git tag -a $tag -m '$tag'" >&2
    exit 1
fi
tagged="$(git rev-parse "$tag^{commit}")"
head="$(git rev-parse HEAD)"
if [ "$tagged" != "$head" ]; then
    echo "pre-push: $tag points at $(git rev-parse --short "$tagged"), but HEAD is $(git rev-parse --short "$head")." >&2
    echo "          Amending after tagging does this. Re-tag:  git tag -f -a $tag -m '$tag'" >&2
    exit 1
fi
